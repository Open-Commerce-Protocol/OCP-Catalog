[Unit]
Description=OCP Job Catalog API instance %i
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/OCP-Catalog/apps/job-catalog-api
EnvironmentFile=/home/ubuntu/workspace/OCP-Catalog/.env.jobs
ExecStartPre=/usr/bin/test "$CATALOG_ID" = "cat_ocp_jobs_prod"
ExecStartPre=/usr/bin/test "$CATALOG_PUBLIC_BASE_URL" = "https://overseajobs.catalog.pageflux.net"
Environment=JOB_CATALOG_API_PORT=%i
ExecStart=/home/ubuntu/.bun/bin/bun --env-file=/home/ubuntu/workspace/OCP-Catalog/.env.jobs src/index.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
