CATALOG_ID=cat_ocp_domestic_jobs_prod
CATALOG_NAME=OCP Domestic Jobs Matching Catalog
CATALOG_PUBLIC_BASE_URL=https://domesticjobs.catalog.pageflux.net
CORS_ALLOWED_ORIGINS=https://ocp.deeplumen.io
INGEST_API_KEY=replace-with-a-random-secret
PORT=4400

DATABASE_URL=postgres://user:password@host:5432/domestic_job_catalog
DB_SSL=true

OPENSEARCH_NODE=https://search.example.internal
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=ocp_domestic_jobs_prod_v1

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-an-embedding-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

ENABLE_SEMANTIC=true
MAX_QUERY_LIMIT=50
DEFAULT_RECALL_LIMIT=2000
