{
  "name": "@ocp-catalog/domestic-job-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "bun build src/index.ts src/worker.ts --outdir dist --target bun",
    "test": "bun test",
    "db:init": "bun scripts/init-db.ts",
    "opensearch:init": "bun scripts/init-opensearch.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@opensearch-project/opensearch": "^3.5.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.16",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
