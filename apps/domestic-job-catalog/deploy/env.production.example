CATALOG_ID=cat_ocp_domestic_jobs_prod
CATALOG_NAME=OCP Domestic Jobs Matching Catalog
CATALOG_PUBLIC_BASE_URL=https://domesticjobs.catalog.pageflux.net
CORS_ALLOWED_ORIGINS=https://ocp.deeplumen.io
INGEST_API_KEY=<random-ingest-secret>
PORT=4310

DATABASE_URL=postgres://ocp:<password>@<rds-host>:5432/ocp_domestic_jobs_prod?sslmode=require
DB_SSL=true

OPENSEARCH_NODE=https://<opensearch-endpoint>
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=ocp-domestic-jobs-catalog-vectors-v1

EMBEDDING_BASE_URL=https://<openai-compatible-base>/v1
EMBEDDING_API_KEY=<embedding-api-key>
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

ENABLE_SEMANTIC=true
MAX_QUERY_LIMIT=50
DEFAULT_RECALL_LIMIT=2000
